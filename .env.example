# ---- Credentials ------------------------------------------------------------
# Project-scoped OpenAI key with a hard spend limit. NEVER commit a real .env.
OPENAI_API_KEY=sk-your-project-key-here

# ---- Models per stage (verify identifiers against the current OpenAI model list) ----
MODEL_REQUEST_ANALYSER=gpt-4o-mini     # light classification task
MODEL_PLANNER=gpt-4o                   # reasoning-heavy decomposition
MODEL_RESEARCHER=gpt-4o-mini           # tool selection loop, many calls
MODEL_EVIDENCE_ANALYST=gpt-4o-mini     # extraction, near-deterministic
MODEL_SYNTHESIS=gpt-4o                 # reasoning-heavy
MODEL_QUALITY_CONTROL=gpt-4o           # adversarial checker
MODEL_REPORT_GENERATOR=gpt-4o-mini     # formatting / executive summary

# ---- Temperatures per stage (see docs/technical_documentation.md, Task 02) ----
TEMP_REQUEST_ANALYSER=0.0
TEMP_PLANNER=0.2
TEMP_RESEARCHER=0.0
TEMP_EVIDENCE_ANALYST=0.0
TEMP_SYNTHESIS=0.3
TEMP_QUALITY_CONTROL=0.0
TEMP_REPORT_GENERATOR=0.2

# ---- Loop bounds and budget -------------------------------------------------
MAX_ITERATIONS=40              # model turns inside the research loop
MAX_TOOL_CALLS=60              # total tool executions per run
MAX_STEPS_PER_QUESTION=6       # turns spent on one sub-question
BUDGET_USD=1.50                # cumulative cost ceiling per run
MAX_REPAIR_ROUNDS=2            # QC -> research repair cycles

# ---- Reliability ---------------------------------------------------------------
REQUEST_TIMEOUT_S=60           # per API request
MAX_RETRIES=4                  # transient-error retries (exponential backoff + jitter)
TOOL_TIMEOUT_S=10              # per tool execution

# ---- Paths / misc ---------------------------------------------------------------
CORPUS_DIR=data/corpus
RUNS_DIR=runs
CORPUS_REFERENCE_DATE=2026-06-30   # "today" for recency buckets in the frozen corpus
LOG_LEVEL=INFO
# Optional JSON override of per-1M-token prices, e.g. {"gpt-4o":[2.5,10.0]}
MODEL_PRICING_JSON=
